# Optional runtime configuration for the `amc` CLI.
# Every value is optional; the CLI runs read-only commands with no configuration.

# Where the CLI persists the AMC session jar (defaults to the OS home directory).
AMC_SESSION_ROOT=/absolute/path/to/private/runtime

# ADVANCED MANUAL OVERRIDE (not required for normal use). Explicit `amc auth
# repair` already auto-aligns and persists the browser's direct-transport
# fingerprint from https://tls.peet.ws/api/all, so most users never set this.
# When set, the CLI registers this manually captured Peet profile and pins the
# transport to it, and this manual pin always WINS over the auto-aligned one.
AMC_HELLO_PROFILE_PATH=/absolute/path/to/peet-profile.json
AMC_HELLO_PROFILE_NAME=amc-browser

# Optional outbound proxy URL for the default HelloJS transport.
AMC_PROXY_URL=

# Optional capability module (CommonJS) exporting a no-argument
# `createAmcCapabilities()` factory that returns { cardProvider?, browserRepair?,
# challengeHandler?, recovery?, defaultReceiptEmail?, defaultVaultPointer? } for
# checkout (see `CreateAmcCapabilities` in "@ashah360/open-amc/cli"). The CLI
# passes no context: the module reads its own configuration and never receives
# session contents or secrets. With one-time receipt/payment defaults
# configured, `amc checkout submit --token <orderToken>` is sufficient;
# --email/--vault stay available as per-command overrides. Minimal synthetic
# example:
#
#   "use strict";
#   exports.createAmcCapabilities = () => ({
#     defaultReceiptEmail: "guest@example.test",
#     defaultVaultPointer: "vault://your-provider/pointer",
#   });
#
# The public package ships NO card provider, proxy, or identity implementation.
AMC_CAPABILITY_MODULE=/absolute/path/to/your/amc-capabilities.cjs
