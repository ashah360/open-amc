{
  "name": "@ashah360/open-amc",
  "version": "0.1.0",
  "description": "Typed, single-operation AMC showtime, seat inventory, cart, checkout, and refund client with a thin CLI. Unofficial and not affiliated with or endorsed by AMC.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "amc": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./transport": {
      "types": "./dist/transport/index.d.ts",
      "default": "./dist/transport/index.js"
    },
    "./capabilities/browser": {
      "types": "./dist/capabilities/browser/index.d.ts",
      "default": "./dist/capabilities/browser/index.js"
    },
    "./playwright": {
      "types": "./dist/capabilities/browser/playwright/index.d.ts",
      "default": "./dist/capabilities/browser/playwright/index.js"
    },
    "./capabilities/payment": {
      "types": "./dist/capabilities/payment/index.d.ts",
      "default": "./dist/capabilities/payment/index.js"
    },
    "./recovery": {
      "types": "./dist/recovery/index.d.ts",
      "default": "./dist/recovery/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --config vitest.config.mts",
    "privacy:audit": "python3 scripts/privacy_audit.py",
    "pack:smoke": "node scripts/pack_smoke.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run privacy:audit && npm test && npm run build && npm run pack:smoke",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@unreleased/hellojs": "^0.2.5",
    "commander": "^12.1.0",
    "undici": "^6.19.8"
  },
  "peerDependencies": {
    "braintree-web": "3.144.0",
    "playwright-core": ">=1.40.0 <2"
  },
  "peerDependenciesMeta": {
    "braintree-web": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "braintree-web": "3.144.0",
    "eslint": "^8.57.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^4.1.10"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [
    "amc",
    "showtimes",
    "seats",
    "checkout",
    "graphql",
    "cli",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashah360/open-amc.git"
  },
  "author": "",
  "homepage": "https://github.com/ashah360/open-amc#readme"
}
